        public void lookup()
        {
            SysTableLookup        sysTableLookup = SysTableLookup::newParameters(tableNum(OMOperatingUnit), this);
            Query                 query = new Query();
            QueryBuildDataSource  qbds;

            // Add the business unit table to the query
            qbds = query.addDataSource(tableNum(OMOperatingUnit));

            // Filter by Operating Unit Type - Business Unit
            qbds.addRange(fieldNum(OMOperatingUnit, OMOperatingUnitType)).value(queryValue(OMOperatingUnitType::OMBusinessUnit));
    
            // Add fields to display in the dropdown grid
            sysTableLookup.addLookupfield(fieldNum(OMOperatingUnit, OMOperatingUnitNumber));
            sysTableLookup.addLookupfield(fieldNum(OMOperatingUnit, Name));
    
            // Pass the query to the lookup form
            sysTableLookup.parmQuery(query);
            sysTableLookup.performFormLookup();
            //super();
        }

    }

