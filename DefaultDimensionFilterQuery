        public display str getLineType(SalesLine _salesLine)
        {
            SalesLine       salesLineCount;
            str             ret;
            select count(RecId) from salesLineCount where salesLineCount.SalesId == _salesLine.SalesId;

            if(salesLineCount.RecId > 1)
            {
                ret = enum2Str(AFZMultiLine::Multi);
            }
            else
            {
                ret = enum2Str(AFZMultiLine::Single);
            }

            return ret;
        }

