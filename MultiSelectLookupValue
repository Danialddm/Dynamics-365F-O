--create one form string control on the form and select the proper datasource and then:
[ExtensionOf(formStr(LedgerJournalControl))]
public final class AFZLedgerjournalControl_Frm_Extension
{
    public SysLookupMultiSelectCtrl multiSelect;
    public SysLookupMultiSelectCtrl multiSelect_cust;
    public SysLookupMultiSelectCtrl parmMultiSelect()
    { 
        return multiSelect;
    }

    public SysLookupMultiSelectCtrl parmMultiSelect_cust()
    {
        return multiSelect_cust;
    }

    public void init()
    {
        next init();


        FormStringControl formCtrl_Vend, formCtrl_Cust;


        formCtrl_Vend = this.design().controlName(formControlStr(LedgerJournalControl, VendGrpLookup));
        multiSelect = SysLookupMultiSelectCtrl::construct(this,formCtrl_Vend,queryStr(VendGroupSRS));

        formCtrl_Cust = this.design().controlName(formControlStr(LedgerJournalControl, CustGrpLookup));
        multiSelect_cust = SysLookupMultiSelectCtrl::construct(this,formCtrl_Cust,queryStr(CustGroupSRS));
    }

}
