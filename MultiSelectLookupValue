internal static class AFZLedgerJournalControl_VendCustGroup_EHNDL
{  
    [FormDataFieldEventHandler(formDataFieldStr(LedgerJournalControl, LedgerJournalName, AFZVendGroup), FormDataFieldEventType::Modified)]
    public static void AFZVendGroup_OnModified(FormDataObject sender, FormDataFieldEventArgs e)
    {

        FormRun formRun = sender.datasource().formRun();
        SysLookupMultiSelectCtrl multiSelectCtr = formRun.parmMultiSelect();
        LedgerJournalName ledName = formRun.dataSource(formDataSourceStr(LedgerJournalControl,LedgerJournalName)).cursor();
        ledName.AFZVendGroup = con2Str(multiSelectCtr.getSelectedFieldValues(), ';');
        sender.datasource().write();
    }

    [FormDataFieldEventHandler(formDataFieldStr(LedgerJournalControl, LedgerJournalName, AFZCustGroup), FormDataFieldEventType::Modified)]
    public static void AFZCustGroup_OnModified(FormDataObject sender, FormDataFieldEventArgs e)
    {

        FormRun formRun = sender.datasource().formRun();
        SysLookupMultiSelectCtrl multiSelectCtr_cust = formRun.parmMultiSelect_cust();
        LedgerJournalName ledName = formRun.dataSource(formDataSourceStr(LedgerJournalControl,LedgerJournalName)).cursor();
        ledName.AFZCustGroup = con2Str(multiSelectCtr_cust.getSelectedFieldValues(), ';');
        sender.datasource().write();
    }

}
