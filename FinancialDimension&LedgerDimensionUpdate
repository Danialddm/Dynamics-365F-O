    private void lookupDefaultView(FormStringControl _ctrl, str _dimName)
    {
        SysTableLookup lookup = SysTableLookup::newParameters(tableNum(DefaultDimensionView), _ctrl);

        lookup.addLookupfield(fieldNum(DefaultDimensionView, DisplayValue), true);

        Query                query = new Query();
        QueryBuildDataSource qbds  = query.addDataSource(tableNum(DefaultDimensionView));

        qbds.addRange(fieldNum(DefaultDimensionView, Name)).value(queryValue(_dimName));

        lookup.parmQuery(query);

        changeCompany(purchLine.DataAreaId)
        {
            lookup.performFormLookup();
        }
    }

