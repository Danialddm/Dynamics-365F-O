    private void save(DimensionAttributeValueSetStorage _storage)
    {
        this.setValue(_storage, DimA, fieldA.value());
        this.setValue(_storage, DimB, fieldB.value());
        this.setValue(_storage, DimC, fieldC.value());
        this.setValue(_storage, DimD, fieldD.value());
        this.setValue(_storage, DimE, fieldE.value());
        this.setValue(_storage, DimF, fieldF.value());
        this.setValue(_storage, DimG, fieldG.value());

        DimensionDefault newDimension = _storage.save();

        ttsbegin;
        PurchLine pt = PurchLine::find(purchLine.PurchId, purchLine.LineNumber, true);
        pt.selectForUpdate(true);
        pt.skipEvents(true);
        pt.DefaultDimension = newDimension;
        pt.doUpdate();

        AccountingDistribution accountingDistribution;
        DimensionAttribute     dimAttr;
        LedgerDimensionAccount newLedgerDimension;
        //MainAccount-LineofBusiness-Department-Responsibilitycenter-CostCenter-RevenueClassification
        select firstonly forupdate accountingDistribution
            where accountingDistribution.SourceDocumentLine == purchLine.SourceDocumentLine;
        newLedgerDimension = accountingDistribution.LedgerDimension;

        // Update Line of Business
        dimAttr = DimensionAttribute::findByName("LineofBusiness");

        newLedgerDimension = this.replaceDimensionValue(
        newLedgerDimension,
        dimAttr,
        fieldD.value());

            // Update Department
        dimAttr = DimensionAttribute::findByName("Department");

        newLedgerDimension = this.replaceDimensionValue(
        newLedgerDimension,
        dimAttr,
        fieldB.value());

        // Responsibilitycenter
        dimAttr = DimensionAttribute::findByName("Responsibilitycenter");

        newLedgerDimension = this.replaceDimensionValue(
        newLedgerDimension,
        dimAttr,
        fieldF.value());

            // Update Cost Center
        dimAttr = DimensionAttribute::findByName("CostCenter");

        newLedgerDimension = this.replaceDimensionValue(
            newLedgerDimension,
            dimAttr,
            fieldA.value());

        // Update RevenueClassification
        dimAttr = DimensionAttribute::findByName("RevenueClassification");

        newLedgerDimension = this.replaceDimensionValue(
            newLedgerDimension,
            dimAttr,
            fieldG.value());

        // Replace previous Ledger Dimension
        accountingDistribution.LedgerDimension = newLedgerDimension;
        accountingDistribution.update();
        ttscommit;
        info("Update was done successfully.");
    }

    public LedgerDimensionAccount replaceDimensionValue(
        LedgerDimensionAccount _ledgerDimension,
        DimensionAttribute     _dimAttr,
        DimensionValue         _toDimensionVal)
    {
        LedgerDimensionAccount              ledgerDimension;
        DimensionDefault                    defaultDimension;
        DimensionDefault                    replaceDimension;
        DimensionAttributeValue             dimAttrValue;
        DimensionAttributeValueSetStorage   dimAttrValDimStorage;
        MainAccount                 mainAccount;
        LedgerDimensionDefaultAccount defaultAccount;
        if (_toDimensionVal != '')
        {
            // convert to Default dimensions
            defaultDimension  =
            LedgerDimensionFacade::getDefaultDimensionFromLedgerDimension(
            _ledgerDimension);
            dimAttrValDimStorage = DimensionAttributeValueSetStorage::find(defaultDimension);

            dimAttrValue = DimensionAttributeValue::findByDimensionAttributeAndValue(_dimAttr, _toDimensionVal);

            dimAttrValDimStorage.addItem(dimAttrValue);
            replaceDimension = dimAttrValDimStorage.save();
            
            mainAccount = MainAccount::findByMainAccountId(
            LedgerDimensionFacade::getMainAccountIdFromLedgerDimension(_ledgerDimension));

            defaultAccount =
            LedgerDefaultAccountHelper::getDefaultAccountFromMainAccountRecId(mainAccount.RecId);

            ledgerDimension = LedgerDimensionFacade::serviceCreateLedgerDimension(defaultAccount, replaceDimension);
        }
        else
        {
            ledgerDimension = _ledgerDimension;
        }

        return ledgerDimension;
    }

    private void setValue(DimensionAttributeValueSetStorage _storage, str _dimName, str _value)
    {
        DimensionAttribute attribute = DimensionAttribute::findByName(_dimName);

        if (!attribute.RecId)
        {
            warning(strFmt("Dimension %1 not found.", _dimName));
            return;
        }

        _value = strLRTrim(_value);

        if (_value == '')
        {
            // Blank means "clear this dimension"
            if (_storage.containsDimensionAttribute(attribute.RecId))
            {
                _storage.removeDimensionAttribute(attribute.RecId);
            }

            return;
        }

        DimensionAttributeValue attrValue =
        DimensionAttributeValue::findByDimensionAttributeAndValue(attribute, _value, false, true);

        _storage.addItem(attrValue);  
    }

