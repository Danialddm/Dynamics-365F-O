    private const str DimA = 'CostCenter';
    private const str DimB = 'Department';
    private const str DimC = 'Employee';
    private const str DimD = 'LineofBusiness';
    private const str DimE = 'Project';
    private const str DimF = 'Responsibilitycenter';
    private const str DimG = 'RevenueClassification';

    PurchLine  purchLine;
    DialogField fieldA;
    DialogField fieldB;
    DialogField fieldC;
    DialogField fieldD;
    DialogField fieldE;
    DialogField fieldF;
    DialogField fieldG;

    public static void show(PurchLine _purchLine)
    {
        if (!_purchLine.RecId)
        {
            return;
        }
        //if(_purchTable.PurchStatus == PurchStatus::Invoiced)
        //{
        //    warning("This PO is fully invoiced. Update financial dimensions is not allowed.");
        //    return;
        //}

        AFZPOLineFinDimUpdate me = new AFZPOLineFinDimUpdate();
        me.purchLine = _purchLine;
        me.run();
    }

    private void run()
    {
        DimensionAttributeValueSetStorage storage =
            DimensionAttributeValueSetStorage::find(purchLine.DefaultDimension);

        Dialog dialog = new Dialog(strFmt("Financial dimensions update for PO: %1", purchLine.PurchId));
        dialog.addText("Select the dimension values.");       
        fieldA = dialog.addField(extendedTypeStr(DimensionValue), DimA);
        fieldB = dialog.addField(extendedTypeStr(DimensionValue), DimB);
        fieldC = dialog.addField(extendedTypeStr(DimensionValue), DimC);
        fieldD = dialog.addField(extendedTypeStr(DimensionValue), DimD);
        fieldE = dialog.addField(extendedTypeStr(DimensionValue), DimE);
        fieldF = dialog.addField(extendedTypeStr(DimensionValue), DimF);
        fieldG = dialog.addField(extendedTypeStr(DimensionValue), DimG);

        // Current values
        fieldA.value(storage.getDisplayValueByDimensionAttribute(DimensionAttribute::findByName(DimA).RecId));
        fieldB.value(storage.getDisplayValueByDimensionAttribute(DimensionAttribute::findByName(DimB).RecId));
        fieldC.value(storage.getDisplayValueByDimensionAttribute(DimensionAttribute::findByName(DimC).RecId));
        fieldD.value(storage.getDisplayValueByDimensionAttribute(DimensionAttribute::findByName(DimD).RecId));
        fieldE.value(storage.getDisplayValueByDimensionAttribute(DimensionAttribute::findByName(DimE).RecId));
        fieldF.value(storage.getDisplayValueByDimensionAttribute(DimensionAttribute::findByName(DimF).RecId));
        fieldG.value(storage.getDisplayValueByDimensionAttribute(DimensionAttribute::findByName(DimG).RecId));

        // Lookups
        fieldA.registerOverrideMethod(methodStr(FormStringControl, lookup), methodStr(AFZPOFinDimUpdate, lookupA), this);
        fieldB.registerOverrideMethod(methodStr(FormStringControl, lookup), methodStr(AFZPOFinDimUpdate, lookupB), this);
        fieldC.registerOverrideMethod(methodStr(FormStringControl, lookup), methodStr(AFZPOFinDimUpdate, lookupC), this);
        fieldD.registerOverrideMethod(methodStr(FormStringControl, lookup), methodStr(AFZPOFinDimUpdate, lookupD), this);
        fieldE.registerOverrideMethod(methodStr(FormStringControl, lookup), methodStr(AFZPOFinDimUpdate, lookupE), this);
        fieldF.registerOverrideMethod(methodStr(FormStringControl, lookup), methodStr(AFZPOFinDimUpdate, lookupF), this);
        fieldG.registerOverrideMethod(methodStr(FormStringControl, lookup), methodStr(AFZPOFinDimUpdate, lookupG), this);

        if (dialog.run())
        {
            this.save(storage);
        }
    }

    private void showLookup(FormStringControl _ctrl, str _dimName)
    {

        switch (_dimName)
        {
            case DimA:   // CostCenter
            case DimE:   // Project
            case DimG:   // RevenueClassification
                this.lookupFinancialTag(_ctrl, _dimName);
                break;

            case DimB:   // Department
                this.lookupFinancialTag_Department(_ctrl, _dimName);
                break;

            case DimC:   // Employee
                this.lookupFinancialTag_Employee(_ctrl, _dimName);
                break; 

            case DimD:   // LineofBusiness 
                this.lookupFinancialTag_LineofBusiness(_ctrl, _dimName);
                break;

            case DimF:   // Responsibilitycenter
                this.lookupFinancialTag_Responsibilitycenter(_ctrl, _dimName);
                break;

            default:    
                this.lookupDefaultView(_ctrl, _dimName);
                break;           
        }
    }

    private void lookupFinancialTag(FormStringControl _ctrl, str _dimName)
    {
        SysTableLookup lookup = SysTableLookup::newParameters(tableNum(DimensionFinancialTag), _ctrl);

        lookup.addLookupfield(fieldNum(DimensionFinancialTag, Value), true);   // returned to the dialog field
        lookup.addLookupfield(fieldNum(DimensionFinancialTag, Description));

        Query                query   = new Query();
        QueryBuildDataSource qbdsTag = query.addDataSource(tableNum(DimensionFinancialTag));
        QueryBuildDataSource qbdsDef = qbdsTag.addDataSource(tableNum(DefaultDimensionView));

        qbdsDef.joinMode(JoinMode::ExistsJoin);
        qbdsDef.addLink(fieldNum(DimensionFinancialTag, Value), fieldNum(DefaultDimensionView, DisplayValue));
        qbdsDef.addRange(fieldNum(DefaultDimensionView, Name)).value(queryValue(_dimName));

        qbdsTag.addSortField(fieldNum(DimensionFinancialTag, Value));

        lookup.parmQuery(query);
        lookup.performFormLookup();
    }

