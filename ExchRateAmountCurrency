//this method considers the accounting currency of the legal entity
    public display AmountMST afzCalculateTotalAmountAED()
    {
        purchTotals  purchTotals;
        PoAmount     PoAmount;

        if (!this.RecId)
        {
            return 0;
        }
        purchTotals = PurchTotals::newPurchTable(this);
        purchTotals.calc();

        CurrencyExchangeHelper  currencyExchangeHelper;
        CurrencyCode            transCurrency;
        RefRecId               ledgerRecId;

        transCurrency = Ledger::accountingCurrency(CompanyInfo::findDataArea(this.DataAreaId).RecId);
        if(transCurrency != 'AED')
        {
            if(this.CurrencyCode == transCurrency)
            {
                currencyExchangeHelper = CurrencyExchangeHelper::newExchangeDate(Ledger::current(), this.AccountingDate);
                return currencyExchangeHelper.calculateTransactionCurrencyToReportingCurrency(transCurrency, purchTotals.purchTotalAmount());
            }
            else if(this.CurrencyCode == 'AED')
            {
                return purchTotals.purchTotalAmount();
            }
            else
            {
                ledgerRecId = Ledger::primaryLedger(
                CompanyInfo::findDataArea(this.DataAreaId).RecId);

                currencyExchangeHelper =
                CurrencyExchangeHelper::newExchangeDate(
                ledgerRecId,
                this.AccountingDate);

                return      currencyExchangeHelper.calculateTransactionToReporting(
                this.CurrencyCode,
                   // 'AED',                
                purchTotals.purchTotalAmount(),
                true);
                //return CurrencyExchangeHelper::amountCur2MST(purchTotals.purchTotalAmount(), this.CurrencyCode, this.AccountingDate, 'AED');
            }
        }
        else
        {
            return CurrencyExchangeHelper::amountCur2MST(purchTotals.purchTotalAmount(), this.CurrencyCode);
        }
